{
  "name": "unprepared-lawyer",
  "version": "0.1.0",
  "private": true,
  "description": "Unprepared Lawyer — retro courtroom command-center game (Jev decides, LLM voices, code keeps score)",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx scripts/sim.ts",
    "play": "tsx scripts/play.ts",
    "author": "tsx scripts/author.ts",
    "dev:server": "tsx server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config client/vite.config.ts",
    "check": "npm run build && npm test && npm run sim",
    "desktop:dev": "npm --prefix desktop run dev",
    "dist:win": "npm run build && npm --prefix desktop run dist:win"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "@vitejs/plugin-react": "^4.3.2",
    "vitest": "^2.1.3",
    "zod": "^3.23.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.24.0"
  }
}
